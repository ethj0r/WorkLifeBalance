{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["USERNAME", "USER", "LOGNAME"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {}
  }
}